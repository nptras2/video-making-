# ─────────────────────────────────────────────────────────────────────────────
# AI Video Production Engine — optional configuration
#
# Copy to `.env` and fill in only what you want. NOTHING here is required:
# without any of these keys the engine still produces a finished video using
# local whisper.cpp, local TTS, and FFmpeg-synthesised music, and falls back to
# procedural 2D/3D scenes instead of generated imagery. See PROVIDERS.md.
#
# `.env` is git-ignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM director (plans the timeline) ────────────────────────────────────────
# Any OpenAI-compatible endpoint works (OpenAI, Azure-style gateways, local
# servers such as Ollama/LM Studio/vLLM that expose /chat/completions).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# VIDEO_LLM_MODEL=gpt-4o-mini
# Provider-neutral alternative (takes effect when OPENAI_API_KEY is unset):
# LLM_API_KEY=
# LLM_BASE_URL=

# ── Narration voices ─────────────────────────────────────────────────────────
# Unset ⇒ offline Windows System.Speech is used (Windows only).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# TTS_PROVIDER=elevenlabs        # elevenlabs | openai | local

# ── Speech to text ───────────────────────────────────────────────────────────
# Default is fully offline whisper.cpp (installed on first use).
# WHISPER_MODEL=base             # tiny | base | small | medium | large-v3 — 'small' gives noticeably better word timings
# STT_PROVIDER=whisper           # whisper | openai

# ── AI image generation (scene plates) ───────────────────────────────────────
# STABILITY_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=stability-ai/sdxl

# ── AI video generation (text/image → video clips) ───────────────────────────
# LUMA_API_KEY=
# RUNWAY_API_KEY=
# RUNWAY_MODEL=gen4_turbo
# REPLICATE_VIDEO_MODEL=minimax/video-01

# ── Stock B-roll / stills ────────────────────────────────────────────────────
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=

# ── Licensed music ───────────────────────────────────────────────────────────
# JAMENDO_CLIENT_ID=

# ── Tooling overrides ────────────────────────────────────────────────────────
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# VIDEO_DEBUG=1                  # print stack traces on CLI errors
